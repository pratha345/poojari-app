# ── Frontend Environment Variables ──────────────────────────
# Copy this file to .env.development (local) and .env.production (deploy).

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Backend base URL — used for loading images from /uploads/
VITE_BACKEND_URL=http://localhost:5000

# Public site URL — used for SEO canonical, OG tags, structured data.
# MUST match the domain your users visit.
#   local:  VITE_SITE_URL=http://localhost:5173
#   prod:   VITE_SITE_URL=https://yourdomain.com
VITE_SITE_URL=http://localhost:5173

# Google Maps API key — required for Hall Booking map view
# Get yours at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
